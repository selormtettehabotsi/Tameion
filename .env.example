# Root compose environment. Copy to .env and adjust.
#   cp .env.example .env
#
# The development stack (docker-compose.yml) falls back to these defaults if
# .env is absent, so it runs out of the box. The production stack
# (docker-compose.prod.yml) requires POSTGRES_PASSWORD to be set explicitly.

POSTGRES_DB=alms
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Host port bindings
DB_PORT=5432
SERVER_PORT=5000
CLIENT_PORT=5173

# Production only (docker-compose.prod.yml)
# APP_PORT=80
