{
  "name": "tameion-server",
  "version": "1.0.0",
  "description": "Tameion - Automated Library Management System - Server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "node --watch index.js",
    "migrate": "node-pg-migrate --migration-file-language js --migrations-dir migrations",
    "migrate:up": "npm run migrate -- up",
    "migrate:down": "npm run migrate -- down",
    "migrate:create": "npm run migrate -- create",
    "test": "jest --runInBand --forceExit",
    "test:unit": "jest --runInBand --forceExit --selectProjects unit",
    "test:integration": "jest --runInBand --forceExit --selectProjects integration"
  },
  "jest": {
    "projects": [
      {
        "displayName": "unit",
        "testEnvironment": "node",
        "testMatch": ["**/tests/unit/**/*.test.js"]
      },
      {
        "displayName": "integration",
        "testEnvironment": "node",
        "testMatch": ["**/tests/integration/**/*.test.js"],
        "globalSetup": "<rootDir>/tests/setup.js",
        "globalTeardown": "<rootDir>/tests/teardown.js"
      }
    ]
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "connect-pg-simple": "^9.0.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.18.0",
    "node-pg-migrate": "^9.0.0",
    "nodemailer": "^9.0.3",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "supertest": "^7.2.2"
  }
}
